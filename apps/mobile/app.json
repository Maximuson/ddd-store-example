{
  "expo": {
    "name": "DDD Store",
    "slug": "ddd-store-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ddd-store",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2563eb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dddstore.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      },
      "package": "com.dddstore.mobile"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
