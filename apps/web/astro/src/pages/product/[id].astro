---
import { mockProductsData } from '@ddd-store/catalog';
import { productPage } from '@ddd-store/web-shared/catalog/pages';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDetail from '../../components/ProductDetail.astro';

export function getStaticPaths() {
  return mockProductsData.map((product) => ({
    params: { id: product.getId() },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<BaseLayout title={productPage.title}>
  <ProductDetail product={product} />
</BaseLayout>
