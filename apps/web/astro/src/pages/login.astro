---
import { loginPage } from '@ddd-store/web-shared/auth/pages';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{loginPage.title}</title>
  </head>
  <body class="min-h-screen bg-gray-50 flex items-center justify-center">
    <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-200 w-full max-w-md text-center">
      <h1 class="text-2xl font-bold text-gray-900 mb-4">{loginPage.title}</h1>
      <p class="text-gray-600 mb-6">
        For full authentication, use the React, Vue, or Angular apps.
      </p>
      <a href="/" class="text-blue-600 hover:underline">← Back to home</a>
    </div>
  </body>
</html>
