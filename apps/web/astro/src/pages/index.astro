---
import { getProducts } from '../lib/productRepository';
import { catalogPage } from '@ddd-store/web-shared/catalog/pages';
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogGrid from '../components/CatalogGrid.astro';

const products = await getProducts();
---

<BaseLayout title="DDD Store (Astro)" showLogin>
  <section class="mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Multi-Framework DDD Store</h1>
    <p class="text-gray-600 max-w-2xl">
      Astro 7 showcase using shared vertical slices from <code>@ddd-store/web-shared</code>.
      Catalog is fully static — product data is generated at build time.
    </p>
  </section>
  <section>
    <h2 class="text-2xl font-bold text-gray-900 mb-6">{catalogPage.title}</h2>
    <CatalogGrid products={products} />
  </section>
</BaseLayout>
