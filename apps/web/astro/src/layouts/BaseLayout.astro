---
import '../styles/global.css';
import { catalogPage } from '@ddd-store/web-shared/catalog/pages';

interface Props {
  title: string;
  showLogin?: boolean;
}

const { title, showLogin = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-gray-50">
    <nav class="bg-white border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex h-16 items-center gap-6">
        <a href="/" class="text-xl font-bold text-blue-600">DDD Store</a>
        <a href={catalogPage.path} class="text-gray-600 hover:text-gray-900">Catalog</a>
        {showLogin && (
          <a href="/login" class="text-gray-600 hover:text-gray-900">Login</a>
        )}
      </div>
    </nav>
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>
  </body>
</html>
