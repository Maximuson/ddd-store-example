{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@ddd-store/shared": ["../../../packages/shared/src/index.ts"],
      "@ddd-store/shared/*": ["../../../packages/shared/src/*"],
      "@ddd-store/auth": ["../../../packages/auth/src/index.ts"],
      "@ddd-store/auth/*": ["../../../packages/auth/src/*"],
      "@ddd-store/users": ["../../../packages/users/src/index.ts"],
      "@ddd-store/users/*": ["../../../packages/users/src/*"],
      "@ddd-store/catalog": ["../../../packages/catalog/src/index.ts"],
      "@ddd-store/catalog/*": ["../../../packages/catalog/src/*"],
      "@ddd-store/web-shared": ["../shared/index.ts"],
      "@ddd-store/web-shared/*": ["../shared/*"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "include": ["src/**/*.ts"]
}
